# Copie este arquivo para ".env.local" e preencha:

# (OPCIONAL) Chave da Steam Web API: https://steamcommunity.com/dev/apikey
# Sem chave o site funciona igual — nome e avatar vêm do perfil público da Steam.
STEAM_API_KEY=

# Endereço que os seus amigos vão usar pra acessar o site.
# Rodando só no seu PC: http://localhost:3000
# Com Cloudflare Tunnel: https://seu-tunel.trycloudflare.com
# IMPORTANTE: o login da Steam exige que o BASE_URL seja exatamente
# o endereço digitado no navegador.
BASE_URL=http://localhost:3000
