# Copie este arquivo para ".env.local" e preencha:

# (OPCIONAL) Chave da Steam Web API: https://steamcommunity.com/dev/apikey
# Sem chave o site funciona igual — nome e avatar vêm do perfil público da Steam.
STEAM_API_KEY=

# (OPCIONAL) Força um endereço fixo pro login da Steam.
# Por padrão o site detecta sozinho pelo endereço que o navegador usou, que é
# o comportamento certo tanto no localhost quanto na Vercel.
# Só preencha se precisar fixar (ex.: túnel do Cloudflare, IP de VPN).
# Precisa incluir o protocolo — sem ele a Steam recusa com "Invalid return protocol".
BASE_URL=http://localhost:3000

# OBRIGATÓRIO. Segredo que assina o cookie de sessão.
# Gere com: openssl rand -hex 32
# Na Vercel isso é obrigatório: sem ele, cada instância geraria um segredo
# diferente e os jogadores seriam deslogados aleatoriamente.
SESSION_SECRET=asdfasfa

# OBRIGATÓRIO. Banco Turso (libSQL) — crie grátis em https://turso.tech
#   turso db create resenha-cs
#   turso db show resenha-cs --url
#   turso db tokens create resenha-cs
TURSO_DATABASE_URL=libsql://cs-resenha-rapha387.aws-us-east-1.turso.io
